# Copy to .env and fill in. Never commit .env.

# Profile: cloud (GPU STT + Groq LLM) | cpu (Groq STT + Groq LLM) | local (optional, full local)
VOICE_PROFILE=cloud

# --- LLM ---
GROQ_API_KEY=
# Agent model is chosen empirically in M2 (docs/notes/model-choice.md)
GROQ_AGENT_MODEL=
GROQ_SIMULATOR_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# --- STT ---
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- TTS ---
KOKORO_VOICE=

# --- App ---
DB_PATH=data/osteria.db
LOG_LEVEL=INFO
TURNS_LOG_PATH=logs/turns.jsonl
TOOL_TIMEOUT_SECS=2.0
CHAT_REPLY_TIMEOUT_SECS=60
# e.g. check_availability:error:1.0,search_menu:timeout:0.3 (eval scenarios tagged `fault` only)
FAULT_INJECTION=

# --- Tracing (optional) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
